# ---- Personal data of this computer: keys, saved layouts, logs, caches (never published) ----
local/

# ---- Python environments (recreated by the installer); local tool settings with absolute paths ----
.venv*/
.mcp.json
AGENTS.md
.claude/

# ---- Safety net: a key file left outside local/ is never published ----
*.env
!config/api_keys.example.env

# ---- Caches ----
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ---- OS / editor clutter ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
