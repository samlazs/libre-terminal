# =====================================================================
#  API keys - ALL OPTIONAL. The terminal works without any key.
#
#  This is the template. Your own copy is local/api_keys.env, which
#  Setup-Keys creates from this file the first time. Keys are stored
#  locally (never logged or committed) and are sent only to each
#  provider's own API, when that provider is queried.
#
#  Fill in what you have, leave the rest blank, save, then:
#    Windows:      Setup-Keys.cmd --no-edit   (or just double-click Setup-Keys.cmd)
#    macOS/Linux:  sh setup-keys.sh --no-edit
#  This merges the keys into ~/.openbb_platform/user_settings.json
#  (read by both backends). Then restart the terminal (stop, start).
#
#  Works with NO key: Yahoo Finance, SEC, IMF, OECD, ECB, BIS, Federal
#  Reserve, U.S. Treasury, CFTC, FINRA, CBOE, Deribit, TMX, Nasdaq
#  Nordic, JODI, USDA, Fama-French, IMF PortWatch, ... (EconDB and
#  Finviz belong to the optional legacy V4 backend.)
# =====================================================================

# ---------- The useful FREE keys ----------
# FRED: 800k+ U.S. & international macro series, commodity spot, credit spreads, SLOOS, CP rates
#   https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# BLS: CPI/PPI, employment, wages and productivity series
#   https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# EIA: U.S. and world energy - petroleum, gas, electricity, STEO (the Energy dashboard)
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Congress.gov: bills, votes, members, committee reports
#   https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# Financial Modeling Prep (legacy V4 backend): global fundamentals, transcripts, estimates, ETFs (free tier: 250 calls/day)
#   https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# ---------- Other free keys ----------
# CFTC (Socrata app token): optional, raises COT/swap-data rate limits
#   https://publicreporting.cftc.gov/  -> sign up -> Developer Settings -> App Token
CFTC_APP_TOKEN=

# Polygon / Massive (V4): U.S. stocks, options, FX, crypto aggregates (free tier)
#   https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# Tiingo (V4): end-of-day prices, news, crypto, FX (free tier)
#   https://www.tiingo.com/account/api/token
TIINGO_TOKEN=

# Alpha Vantage (V4): prices, intraday, EPS (free tier: 25 calls/day)
#   https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Nasdaq Data Link (ex-Quandl)
#   https://data.nasdaq.com/sign-up
NASDAQ_API_KEY=

# Tradier (V4): real-time quotes and options (free with a brokerage or sandbox account). Account type: sandbox or live
#   https://developer.tradier.com/
TRADIER_API_KEY=
TRADIER_ACCOUNT_TYPE=sandbox

# BizToc (V4): world and company news (via RapidAPI, free tier)
#   https://rapidapi.com/thma/api/biztoc
BIZTOC_API_KEY=

# EconDB (V4): optional (works keyless with a temporary token; a key raises limits)
#   https://www.econdb.com/
ECONDB_API_KEY=

# ---------- PAID (V4 only) ----------
# Intrinio: fundamentals, options, ETFs              https://intrinio.com
INTRINIO_API_KEY=
# Benzinga: news, analyst ratings                    https://www.benzinga.com/apis
BENZINGA_API_KEY=
# Trading Economics: global calendar and indicators  https://tradingeconomics.com/api
TRADINGECONOMICS_API_KEY=
